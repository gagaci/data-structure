{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: build active file",
      "type": "shell",
      "command": "clang++",
      "args": [
        "-std=c++17",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}"
      ],
      "group": "build",
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "C++: build & run active file",
      "type": "shell",
      "command": "clang++ -std=c++17 -g \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\"",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "presentation": { "reveal": "always", "clear": true }
    },
    {
      "label": "Java: compile active file",
      "type": "shell",
      "command": "javac",
      "args": ["${file}"],
      "options": { "cwd": "${fileDirname}" },
      "group": "build",
      "problemMatcher": ["$tsc"],
      "presentation": { "reveal": "silent", "clear": true }
    },
    {
      "label": "Java: compile & run active file",
      "type": "shell",
      "command": "javac \"${fileBasename}\" && java \"${fileBasenameNoExtension}\"",
      "options": { "cwd": "${fileDirname}" },
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "clear": true }
    }
  ]
}
